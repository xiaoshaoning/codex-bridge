# DeepSeek API key (required)
DEEPSEEK_API_KEY=sk-your-key-here

# Fallback: ANTHROPIC_AUTH_TOKEN from Claude Code config (alternative to DEEPSEEK_API_KEY)
# ANTHROPIC_AUTH_TOKEN=sk-your-key-here
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Optional: fallback API key
# OPENAI_API_KEY=

# Optional: shutdown secret for POST /shutdown
# SHUTDOWN_SECRET=

# Optional: server port
# PORT=8098
